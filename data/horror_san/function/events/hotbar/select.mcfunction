# 仅从九个快捷栏槽位中等概率选择一对；主背包、护甲、副手、末影箱均不会访问。
# 先将两件完整 ItemStack（含 components）快照到 storage；箱子矿车只在同一函数内作 /item 的合法临时来源。
execute if entity @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer] run kill @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer]
scoreboard players set #swap horror_san.rng 0
execute store result score @s horror_san.rng run random value 0..35

# 快捷栏 0 与 1
execute if score @s horror_san.rng matches 0 if data entity @s Inventory[{Slot:0b}] if data entity @s Inventory[{Slot:1b}] run data modify storage horror_san:swap first set from entity @s Inventory[{Slot:0b}]
execute if score @s horror_san.rng matches 0 if data entity @s Inventory[{Slot:0b}] if data entity @s Inventory[{Slot:1b}] run data modify storage horror_san:swap second set from entity @s Inventory[{Slot:1b}]
execute if score @s horror_san.rng matches 0 if data entity @s Inventory[{Slot:0b}] if data entity @s Inventory[{Slot:1b}] run summon minecraft:chest_minecart ~ ~ ~ {Tags:["horror_san.swap_buffer"],Invisible:1b,NoGravity:1b,Silent:1b,Invulnerable:1b,DeathLootTable:"minecraft:empty",Items:[]}
execute if score @s horror_san.rng matches 0 if data entity @s Inventory[{Slot:0b}] if data entity @s Inventory[{Slot:1b}] if entity @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer,distance=..1,limit=1,sort=nearest] run item replace entity @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer,distance=..1,limit=1,sort=nearest] container.0 from entity @s hotbar.0
execute if score @s horror_san.rng matches 0 if data entity @s Inventory[{Slot:0b}] if data entity @s Inventory[{Slot:1b}] if entity @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer,distance=..1,limit=1,sort=nearest] if data entity @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer,distance=..1,limit=1,sort=nearest] Items[{Slot:0b}] run item replace entity @s hotbar.0 from entity @s hotbar.1
execute if score @s horror_san.rng matches 0 if data entity @s Inventory[{Slot:0b}] if data entity @s Inventory[{Slot:1b}] if entity @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer,distance=..1,limit=1,sort=nearest] if data entity @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer,distance=..1,limit=1,sort=nearest] Items[{Slot:0b}] run execute store success score #swap horror_san.rng run item replace entity @s hotbar.1 from entity @e[type=minecraft:chest_minecart,tag=horror_san.swap_buffer,distance=..1,limit=1,sort=nearest] container.0

